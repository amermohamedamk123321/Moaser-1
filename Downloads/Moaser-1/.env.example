# Server Configuration
PORT=5000
NODE_ENV=production
HOST=0.0.0.0

# Frontend Configuration
VITE_API_URL=https://moaserdentalhospital.com/api
FRONTEND_URL=https://moaserdentalhospital.com

# JWT Configuration
JWT_SECRET=generate-a-strong-random-string-here-min-32-characters
JWT_EXPIRY=24h

# Database Configuration
DATABASE_PATH=./server/evaluations.db

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Admin Default (change after first login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-secure-password
ADMIN_EMAIL=admin@yourdomain.com
