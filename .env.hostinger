# ====================================
# HOSTINGER VPS PRODUCTION CONFIGURATION
# ====================================
# Copy this file to .env and update values before deploying
# DO NOT commit this file to git with real secrets!

# Server Configuration
PORT=5000
NODE_ENV=production
HOST=0.0.0.0

# Frontend Configuration
# Replace yourdomain.com with your actual domain
VITE_API_URL=https://yourdomain.com/api
FRONTEND_URL=https://yourdomain.com

# JWT Configuration
# IMPORTANT: Generate a strong random string!
# Run: openssl rand -base64 32
# Copy the output below (must be 32+ characters)
JWT_SECRET=your-super-secure-random-string-min-32-characters-CHANGE-THIS

JWT_EXPIRY=24h

# Database Configuration
# Keep this path as-is for SQLite database
DATABASE_PATH=./server/evaluations.db

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Admin Default Credentials
# IMPORTANT: Change these immediately after first login!
# Use a strong password (min 12 characters, mix of upper/lower/numbers/symbols)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YourVerySecurePasswordHere123!@
ADMIN_EMAIL=your-email@yourdomain.com

# Optional: Logging
# LOG_LEVEL=info
# LOG_FILE=/root/moaser-clinic/logs/server.log
