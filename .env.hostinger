# ====================================
# HOSTINGER VPS PRODUCTION CONFIGURATION
# ====================================
# Copy this file to .env and update values before deploying
# DO NOT commit this file to git with real secrets!

# Server Configuration
PORT=5000
NODE_ENV=production
HOST=0.0.0.0

# Frontend Configuration
# IMPORTANT: Replace yourdomain.com with your actual domain
# Example: https://dentalclinic.com
VITE_API_URL=https://yourdomain.com/api
FRONTEND_URL=https://yourdomain.com

# JWT Configuration
# IMPORTANT: Generate a strong random string!
# Generate with: openssl rand -base64 32
# Copy the full output below (will be ~44 characters, must be 32+ characters)
# Example: GRJv7lY3pK9mQ2wX8vB5nC4dF6aG7hJ1kL8mN9oP
JWT_SECRET=your-super-secure-random-string-min-32-characters-CHANGE-THIS

JWT_EXPIRY=24h

# Database Configuration
# Keep this path as-is for SQLite database
DATABASE_PATH=./server/evaluations.db

# Rate Limiting
# Window: minutes, Max Requests: per window per IP
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Admin Default Credentials
# IMPORTANT: Change these immediately after first login!
# Username: Can be anything, typically 'admin'
# Password: Must be 12+ characters with mix of upper/lower/numbers/symbols
# Example Password: DentalClinic2024!@#Secure
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YourVerySecurePasswordHere123!@
ADMIN_EMAIL=your-email@yourdomain.com

# Optional: Logging
# Uncomment to enable custom logging locations
# LOG_LEVEL=info
# LOG_FILE=/root/moaser-clinic/logs/server.log

# ====================================
# SETUP INSTRUCTIONS
# ====================================
# 1. Replace 'yourdomain.com' with your actual domain name (without https://)
# 2. Generate JWT_SECRET: run 'openssl rand -base64 32' in terminal
# 3. Create strong admin password (12+ chars, mix of case and symbols)
# 4. Set admin email to receive notifications
# 5. Save this file as .env in the project root
# 6. Run: npm run init-admin
# 7. Run: ./deploy-hostinger.sh
# ====================================
